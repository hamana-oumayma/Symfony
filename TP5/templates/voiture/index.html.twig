{% extends 'base.html.twig' %}

{% block title %}Liste des voitures{% endblock %}

{% block body %}
    <div class="container mt-4">
        <h1 class="mb-4">Liste des voitures</h1>

        {% for message in app.flashes('success') %}
            <div class="alert alert-success alert-dismissible fade show">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}

        <div class="mb-3">
            <a href="{{ path('app_voiture_ajouter') }}" class="btn btn-success">
                <i class="fas fa-plus"></i> Ajouter une voiture
            </a>
            <a href="{{ path('voitures_par_modele') }}" class="btn btn-info">
                <i class="fas fa-filter"></i> Filtrer par modèle
            </a>
            <a href="{{ path('app_voiture_statistiques') }}" class="btn btn-warning">
                <i class="fas fa-chart-bar"></i> Statistiques
            </a>
        </div>

        {% if voitures is not empty %}
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Série</th>
                        <th>Date mise en marche</th>
                        <th>Modèle</th>
                        <th>Prix/jour</th>
                        <th>Actions</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for voiture in voitures %}
                        <tr>
                            <td>{{ voiture.id }}</td>
                            <td><strong>{{ voiture.serie }}</strong></td>
                            <td>{{ voiture.dateMiseEnMarche ? voiture.dateMiseEnMarche|date('d/m/Y') : 'N/A' }}</td>
                            <td>
                                {% if voiture.modeleRelation %}
                                    <span class="badge bg-primary">{{ voiture.modeleRelation.libelle }}</span>
                                {% else %}
                                    <span class="badge bg-secondary">N/A</span>
                                {% endif %}
                            </td>
                            <td>
                                <span class="fw-bold text-success">{{ voiture.prixJour }} €</span>
                            </td>
                            <td>
                                <a href="{{ path('app_voiture_show', {'id': voiture.id}) }}" class="btn btn-sm btn-info" title="Voir">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a href="{{ path('app_voiture_modifier', {'id': voiture.id}) }}" class="btn btn-sm btn-warning" title="Modifier">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <form method="post" action="{{ path('app_voiture_supprimer', {'id': voiture.id}) }}" style="display: inline-block;">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ voiture.id) }}">
                                    <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Êtes-vous sûr de vouloir supprimer cette voiture ?')" title="Supprimer">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <div class="alert alert-info text-center">
                <h4 class="alert-heading">Aucune voiture</h4>
                <p class="mb-0">Aucune voiture n'a été trouvée. <a href="{{ path('app_voiture_ajouter') }}" class="alert-link">Ajoutez-en une !</a></p>
            </div>
        {% endif %}
    </div>
{% endblock %}